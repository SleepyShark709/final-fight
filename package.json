    "editor": "vite --open editor/editor.html",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SleepyShark709/final-fight.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/SleepyShark709/final-fight/issues"
  },
  "homepage": "https://github.com/SleepyShark709/final-fight#readme",
  "dependencies": {
    "express": "^4.18.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "eslint": "8.56.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react": "7.33.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.18"
  },
  "eslintConfig": {
    "root": true,
    "env": {
