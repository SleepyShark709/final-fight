  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "vite",
    "editor": "vite --open editor/editor.html",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix"
  },
  "entrypoints": {
    "game": "/Users/shark/code/final-fight/index.html -> /Users/shark/code/final-fight/src/main.ts",
    "editor": "/Users/shark/code/final-fight/editor/editor.html"
  },
  "project_structure": {
    "root": "/Users/shark/code/final-fight",
    "core_files": {
      "entry": "src/main.ts - 游戏入口点，资源组装",
      "engine": [
        "src/game/game.ts - 游戏引擎核心",
        "src/game/game_scene.ts - 场景管理基类",
        "src/game/game_image.ts - 图像渲染基类",
        "src/game/game_map.ts - 瓦片地图和摄像机",
        "src/game/debug_module.ts - 调试可视化"
      ],
      "scenes": [
        "src/scene/title/scene-title.ts - 标题场景",
        "src/scene/main/scene.ts - 主游戏场景",
        "src/scene/main/label.ts - 文本标签组件"
      ],
      "entities": [
        "src/character/character.ts - 角色基类",
        "src/character/player.ts - 玩家角色",
        "src/character/enemy.ts - 敌人角色"
      ],
      "ui": [
        "src/value/hp-bar.ts - 血条UI",
        "src/value/attack-value.ts - 伤害数字显示"
      ],
      "utilities": [
        "src/utils/player-util.ts - 玩家图片资源",
        "src/utils/enemy-utils.ts - 敌人图片资源",
        "src/utils/map-util.ts - 地图图片资源",
        "src/utils/index.ts - 工具函数"
      ],
      "config": [
        "src/constants.ts - 游戏常量配置",
        "src/types/index.ts - TypeScript类型定义"
      ]
    },
    "asset_organization": {
      "player_assets": "src/assets/player/ - 玩家动画帧(idle/run/attack/jump)",
      "enemy_assets": "src/assets/enemy/ - 敌人动画帧(idle/walk/attack/die)",
      "map_assets": "src/assets/grass/ - 地图瓦片图片(t1-t11)",
      "background_assets": "src/assets/background/ - 背景图片"
    },
    "config_files": [
      "tsconfig.json - TypeScript编译配置",
      "vite.config.ts - Vite构建配置",
      "package.json - 项目依赖和脚本"
    ],
    "special_files": [
      ".final-fight.context.json - 项目上下文配置(本文件)",
      "index.html - 游戏主页面",
      "editor/editor.html - 地图编辑器",
      "功能说明.md - 功能开发进度",
      "README.MD - 项目说明文档"
    ]
  },
  "controls": {
    "gameplay": {
      "A": "向左移动",
      "D": "向右移动",
      "J": "攻击(支持3种攻击类型)",
      "K": "跳跃(按键时长影响跳跃高度)"
    },
    "debug": {
      "P": "切换调试信息显示",
      "Z": "手动向左滚动地图",
      "X": "手动向右滚动地图",
      "R": "重置玩家位置和地图偏移"
    },
    "navigation": {
      "R": "从标题场景进入游戏"
    }
  },
  "engine": {
    "Game": {
      "file": "/Users/shark/code/final-fight/src/game/game.ts",
      "responsibility": [
        "主循环 runLoop",
        "输入注册 registerAction",
        "资源预加载 init",
        "场景切换 replaceScene"
      ],
      "rendering": { "canvasId": "#id-canvas", "imageSmoothingEnabled": false }
    },
    "GameScene": {
      "file": "/Users/shark/code/final-fight/src/game/game_scene.ts",
      "responsibility": [
        "元素管理 addElement/deleteElement",
        "update/draw 分发"
      ]
    },
    "GameTileMap": {
      "file": "/Users/shark/code/final-fight/src/game/game_map.ts",
      "tileSize": 32,
      "grid": { "rows": 16, "cols": "dynamic (repeat base)" },
      "camera": { 
        "followPlayer": true, 
        "offsetX": "<= 0", 
        "parallax": 0.5,
        "followOffsetX": 200,
        "description": "摄像机跟随玩家，玩家位于屏幕中心偏左位置"
      },
      "collision_system": {
        "vertical": "检测角色脚下地面，支持跳跃和重力",
        "horizontal": "检测墙体阻挡，防止穿墙",
        "methods": ["onTheGround", "isTileWall"]
      },
      "responsibility": [
        "瓦片可见区域渲染优化",
        "世界坐标<->屏幕坐标映射",
        "碰撞检测系统",
        "摄像机跟随控制",
        "地图边界管理"
      ]
    },
    "DebugModule": {
      "file": "/Users/shark/code/final-fight/src/game/debug_module.ts",
      "toggle": "DOM 开关按钮 + P 键",
      "visualize": [
        "玩家/敌人碰撞盒",
        "地面/墙体可视化",
        "摄像机与控制提示",
        "地形图例"
      ]
    }
  },
  "scenes": {
    "SceneTitle": {
      "file": "/Users/shark/code/final-fight/src/scene/title/scene-title.ts",
      "elements": ["GameImage(startbg)", "GameLabel"],
      "transition": { "R": "进入主场景 Scene" }
    },
    "Scene": {
      "file": "/Users/shark/code/final-fight/src/scene/main/scene.ts",
      "elements": ["GameTileMap", "Player", "Enemy", "DebugModule"],
      "background": { "imageKey": "bg", "parallaxFactor": 0.5 }
    }
  },
  "entities": {
    "Character": {
      "file": "/Users/shark/code/final-fight/src/character/character.ts",
      "base_class": true,
      "properties": {
        "movement": "基础移动逻辑和朝向控制",
        "animation": "帧动画管理(frames, runFrames, idleFrame)",
