        "cooldown": "COOL_DOWN (10帧)"
      },
      "animation_frames": {
        "idle": "PLAYER_IDLE_IMAGE_NUMBER (6帧)",
        "run": "PLAYER_RUN_IMAGE_NUMBER (6帧)",
        "jump": "PLAYER_JUMP_IMAGE_NUMBER (4帧)"
      },
      "health_system": {
        "maxHP": 100,
        "death_behavior": "切换回标题场景"
      },
      "images_provider": "/Users/shark/code/final-fight/src/utils/player-util.ts"
    },
    "Enemy": {
      "file": "/Users/shark/code/final-fight/src/character/enemy.ts",
      "depends_on": ["HpBar", "AttackValue", "GameTileMap"],
      "ai_system": {
        "tracking": "在水平面范围内追踪玩家",
        "attack_range": "xCollision && yAttackRange",
        "movement_speed": 3,
        "attack_cooldown": "ENEMY_COOL_DOWN (10帧)"
