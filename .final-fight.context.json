      "animation_frames": {
        "idle": "ENEMY_IDLE_NUMBER (4帧)",
        "run": "ENEMY_RUN_NUMBER (5帧)",
        "attack": "ENEMY_ATTACK_NUMBER (8帧)",
        "die": "ENEMY_DIE_NUMBER (4帧)"
      },
      "health_system": {
        "hp": "ENEMY_HP (100)",
        "damage_from_player": "PLAYER_ATTACK_DAMAGE_VALUE"
      },
      "images_provider": "/Users/shark/code/final-fight/src/utils/enemy-utils.ts"
    },
    "UI": {
      "HpBar": {
        "file": "/Users/shark/code/final-fight/src/value/hp-bar.ts",
        "features": ["血量可视化", "跟随角色位置", "适配地图偏移"]
      },
      "AttackValue": {
        "file": "/Users/shark/code/final-fight/src/value/attack-value.ts",
        "features": ["攻击伤害数字显示", "动画效果", "屏幕坐标适配"]
      }
    }
  },
  "assets_loading": {
