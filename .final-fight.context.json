    "workflow": [
      "1. 从瓦片面板选择要绘制的瓦片类型",
      "2. 在画布上点击绘制或双击删除",
      "3. 使用JSON导出按钮获取地图数据",
      "4. 将JSON数据复制到GameTileMap的tiles数组中"
    ]
  },
  "architecture": {
    "overview": "main.ts组装资源与帧率 -> Game预加载并启动 -> SceneTitle -> R键进入Scene(地图/玩家/敌人/调试) -> GameLoop每帧分发update/draw并渲染Canvas",
    "data_flow": {
      "initialization": "main.ts -> 收集所有图片资源 -> Game.init() -> 预加载 -> __start()",
      "game_loop": "Game.runLoop() -> 处理输入 -> scene.update() -> scene.draw() -> requestAnimationFrame",
      "input_handling": "键盘事件 -> registerAction -> actions执行 -> 角色状态更新",
      "rendering": "世界坐标 -> 屏幕坐标变换 -> Canvas绘制"
    },
    "module_dependencies": {
      "core": ["Game", "GameScene", "GameImage"],
      "map_system": ["GameTileMap", "背景系统", "碰撞检测"],
      "entity_system": ["Character基类", "Player", "Enemy"],
      "ui_system": ["HpBar", "AttackValue", "DebugModule"],
      "asset_system": ["PlayerImages", "EnemyImages", "MapImages"]
    },
    "mermaid": "flowchart TD; \n  A[index.html] --> B[src/main.ts];\n  B --> C[收集图片资源];\n  C --> D[Game实例化];\n  D --> E[资源预加载];\n  E --> F[SceneTitle];\n  F --> G[GameImage背景];\n  F --> H[GameLabel文本];\n  F -->|R键| I[Scene主场景];\n  I --> J[BackgroundSystem视差背景];\n  I --> K[GameTileMap瓦片地图];\n  I --> L[Player玩家];\n  I --> M[Enemy敌人];\n  I --> N[DebugModule调试];\n  L --> O[HpBar血条];\n  L --> P[物理系统];\n  M --> Q[AI系统];\n  M --> R[AttackValue伤害显示];\n  K --> S[碰撞检测];\n  K --> T[摄像机跟随];\n  D --> U[Input输入系统];\n  D --> V[Canvas渲染];"
  },
