{
  "meta": {
    "name": "final-fight",
    "description": "2D 橫版格斗 + 滚轴地图 + 简易引擎",
    "language": "TypeScript (ESNext)",
    "bundler": "Vite",
    "version": "1.0.0",
    "author": "SleepyShark709",
    "repository": "https://github.com/SleepyShark709/final-fight",
    "license": "ISC",
    "dependencies": {
      "express": "^4.18.1"
    },
    "devDependencies": {
      "@typescript-eslint/eslint-plugin": "6.21.0",
      "@typescript-eslint/parser": "6.21.0",
      "eslint": "8.56.0",
      "eslint-config-prettier": "9.1.0",
      "eslint-plugin-react": "7.33.2",
      "eslint-plugin-react-hooks": "4.6.0",
      "typescript": "^5.8.3",
