        "collision": "与地图的碰撞检测接口"
      }
    },
    "Player": {
      "file": "/Users/shark/code/final-fight/src/character/player.ts",
      "depends_on": ["GameTileMap", "HpBar"],
      "physics_system": {
        "gravity": "GRAVITATIONAL_ACCELERATION + GRAVITATIONAL_ACCELERATION_PERCENT",
        "jump": "JUMP_HEIGHT，支持变高度跳跃",
        "friction": "地面摩擦力和最大速度限制",
        "collision": "垂直和水平碰撞分离处理"
