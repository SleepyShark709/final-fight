{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "prefer-const": "error",
    "no-var": "error",
    "no-console": "warn",
    "no-debugger": "warn",
    "semi": ["error", "always"],
    "eqeqeq": "error",
    "no-duplicate-imports": "error",
    "no-trailing-spaces": "error",
    "eol-last": "error"
  },
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "editor/",
    "**/*.d.ts"
  ]
}