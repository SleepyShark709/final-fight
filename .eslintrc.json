{
  "root": true,
  "env": {
    "browser": true,
    "es2023": true,
    "node": true
  },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "prettier"
  ],
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "prefer-const": "error",
    "no-var": "error",
    "no-console": "warn",
    "no-debugger": "warn",
    "semi": ["error", "always"],
    "eqeqeq": "error",
    "no-duplicate-imports": "error",
    "no-trailing-spaces": "error",
    "eol-last": "error"
  },
  "ignorePatterns": ["dist/", "node_modules/", "editor/", "**/*.d.ts"]
}
